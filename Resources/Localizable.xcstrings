    },
    "未发现支持的音源文件。API 服务源码需要先部署并适配为音源插件。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No supported source files found. API server code needs to be deployed and adapted into a source plugin first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发现支持的音源文件。API 服务源码需要先部署并适配为音源插件。"
          }
        }
      }
    },
    "此文件不是支持的音源格式，需先适配。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file needs adaptation to a supported source format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不是支持的音源格式，需先适配。"
          }
        }
      }
    },
    "尚未检查，导入时会验证格式。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not checked yet. The format will be validated on import."
