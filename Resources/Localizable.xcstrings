          }
        }
      }
    },
    "歌词版式": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyrics Layout"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌词版式"
          }
        }
      }
    },
    "滚动：整段随播放推进、当前行放大。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling: the lyrics move with playback and the current line is enlarged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动：整段随播放推进、当前行放大。"
          }
        }
      }
    },
    "滚动歌词是 Apple Music 风格：当前行居中放大、整段随播放推进并带弹簧跃动。编辑式只显示当前行与前后两行。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling lyrics follow the Apple Music style: the current line is centered and enlarged, and the lyrics move with playback with a springy bounce. Editorial shows only the current line and the lines around it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动歌词是 Apple Music 风格：当前行居中放大、整段随播放推进并带弹簧跃动。编辑式只显示当前行与前后两行。"
          }
        }
      }
    },
    "悬浮深浅外观": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floating Light/Dark Appearance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬浮深浅外观"
          }
        }
      }
    },
    "按播放器所在区域的壁纸亮度自动切换文字深浅。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches text between dark and light based on the wallpaper brightness behind the player."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按播放器所在区域的壁纸亮度自动切换文字深浅。"
          }
        }
      }
    },
    "浅背景用深色字，深背景用浅色字。背景无法判定时跟随系统外观，并给卡片加一层实底保证可读性。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark text on light backgrounds, light text on dark ones. When the background can't be determined, it follows the system appearance and adds a solid backing for readability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浅背景用深色字，深背景用浅色字。背景无法判定时跟随系统外观，并给卡片加一层实底保证可读性。"
          }
        }
      }
    },
    "只作用于迷你条、胶囊与贴边；完整播放器始终不透明。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only to Mini, Capsule and Edge; the full player is always opaque."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只作用于迷你条、胶囊与贴边；完整播放器始终不透明。"
          }
        }
      }
    },
    "0.5× 更舒缓、1.5× 更利落。只影响形态变形与歌词排布切换的时长。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5× is gentler, 1.5× is snappier. Only affects how long form and lyric layout transitions take."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5× 更舒缓、1.5× 更利落。只影响形态变形与歌词排布切换的时长。"
          }
        }
      }
    },
    "只影响形态变形与歌词排布切换的时长，不影响音频淡入淡出。0.5× 更舒缓，1.5× 更利落。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only affects how long form and lyric layout transitions take, not audio fades. 0.5× is gentler, 1.5× is snappier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只影响形态变形与歌词排布切换的时长，不影响音频淡入淡出。0.5× 更舒缓，1.5× 更利落。"
          }
        }
      }
    },
    "跟随系统的「减弱动态效果」开关。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the system “Reduce Motion” setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统的「减弱动态效果」开关。"
          }
        }
      }
    },
    "开启时不播放变形动画，只保留很短的淡入淡出，避免大幅运动引起不适。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, morph animations are skipped and only brief fades remain, to avoid discomfort from large motion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启时不播放变形动画，只保留很短的淡入淡出，避免大幅运动引起不适。"
          }
        }
      }
    },
    "关于 FLOW": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About FLOW"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 FLOW"
          }
        }
      }
    },
    "一件能在桌面上舒展、收缩、折叠的界面。歌词跟着你，不打断你。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An interface that stretches, shrinks and folds on your desktop. Lyrics follow you without getting in the way."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一件能在桌面上舒展、收缩、折叠的界面。歌词跟着你，不打断你。"
          }
        }
      }
    },
    "隐私": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私"
          }
        }
      }
    },
    "不录屏、不读键盘输入；账号密码只存在系统钥匙串里。自动避让只读取窗口位置和大小，不读窗口内容。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No screen recording and no keyboard reading; account passwords are stored only in the system Keychain. Auto-avoid reads only window positions and sizes, never window content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不录屏、不读键盘输入；账号密码只存在系统钥匙串里。自动避让只读取窗口位置和大小，不读窗口内容。"
          }
        }
      }
    },
