        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检查，导入时会验证格式。"
          }
        }
      }
    },
    "提供 Audius、Radio Browser 与 Internet Archive 开放接口模板，按需获取并导入。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get and import open API templates for Audius, Radio Browser, and Internet Archive as needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供 Audius、Radio Browser 与 Internet Archive 开放接口模板，按需获取并导入。"
          }
        }
      }
    },
