    "到点淡出后暂停播放，不关闭应用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When time is up, playback fades out and pauses; the app stays open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到点淡出后暂停播放，不关闭应用。"
          }
