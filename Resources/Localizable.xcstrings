            "state": "translated",
            "value": "离线缓存"
          }
        }
      }
    },
    "听过的在线歌曲会缓存下来再次使用；换音质后会重新下载。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online songs you've played are cached for reuse; changing the quality downloads them again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听过的在线歌曲会缓存下来再次使用；换音质后会重新下载。"
