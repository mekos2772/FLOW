    "第三方组件": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third-Party Components"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方组件"
          }
        }
      }
    },
    "界面与播放基于 SwiftUI / AVFoundation，存储使用 SwiftData，第三方扩展通过系统自带 JavaScriptCore 隔离执行，在线歌词来自用户导入源或公共歌词库；本地 AI 翻唱的模型推理由内嵌的 ONNX Runtime 完成。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interface and playback use SwiftUI / AVFoundation, storage uses SwiftData, third-party extensions run isolated in the system's JavaScriptCore, and online lyrics come from imported sources or public lyric libraries. Local AI cover inference runs on the embedded ONNX Runtime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面与播放基于 SwiftUI / AVFoundation，存储使用 SwiftData，第三方扩展通过系统自带 JavaScriptCore 隔离执行，在线歌词来自用户导入源或公共歌词库；本地 AI 翻唱的模型推理由内嵌的 ONNX Runtime 完成。"
          }
        }
      }
    },
    "第一次打开、或没有记住上次形态时使用这个形态。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used the first time you open the app, or when the last form wasn't remembered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次打开、或没有记住上次形态时使用这个形态。"
          }
        }
      }
    },
    "锁定后只有用户操作能改变形态，系统不再自动收缩。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When locked, only you can change the form; the app no longer shrinks it automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定后只有用户操作能改变形态，系统不再自动收缩。"
          }
        }
      }
    },
    "悬浮歌词排布": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floating Lyrics Layout"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬浮歌词排布"
          }
        }
      }
    },
    "决定悬浮形态里显示几行：单行 / 双行 / 歌词板。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many lines the floating form shows: single line, two lines, or board."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定悬浮形态里显示几行：单行 / 双行 / 歌词板。"
          }
        }
      }
    },
    "自动变形": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Morph"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动变形"
          }
        }
      }
    },
    "关闭后只有用户操作能改形态；空间变化不再引起收缩或降级。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, only you can change the form; changes in available space no longer shrink it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后只有用户操作能改形态；空间变化不再引起收缩或降级。"
          }
        }
      }
    },
    "切到别的应用时收缩": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrink When Switching Apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切到别的应用时收缩"
          }
        }
      }
    },
    "失去焦点时自动收成迷你条。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrinks to the mini bar when the app loses focus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失去焦点时自动收成迷你条。"
          }
        }
      }
    },
    "开启后切走会从完整形态收成迷你条，切回来再展开。想一边听一边在别处工作时关掉它。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, switching away shrinks the full player to the mini bar and switching back expands it. Turn it off if you want to listen while working elsewhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后切走会从完整形态收成迷你条，切回来再展开。想一边听一边在别处工作时关掉它。"
          }
        }
      }
    },
    "关闭后只遵守屏幕安全区，不再回避其他应用窗口。需要辅助功能授权。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, only the screen's safe area is respected and other windows aren't avoided. Requires Accessibility permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后只遵守屏幕安全区，不再回避其他应用窗口。需要辅助功能授权。"
          }
        }
      }
    },
    "空间变多时": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When More Space Is Available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间变多时"
          }
        }
      }
    },
    "全屏应用、空间不足或用户隐藏时采用哪种隐匿方式。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the player hides for full-screen apps, lack of space, or when you hide it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏应用、空间不足或用户隐藏时采用哪种隐匿方式。"
          }
        }
      }
    },
    "锁定后拖动不会移动窗口，自动避让也跳过它。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When locked, dragging won't move the window and auto-avoid skips it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定后拖动不会移动窗口，自动避让也跳过它。"
          }
        }
      }
    },
    "清空记住的位置与形态，回到第一次打开时的样子。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears remembered positions and forms, returning to how it looked the first time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空记住的位置与形态，回到第一次打开时的样子。"
          }
        }
      }
    },
    "当前行字号；前后行按比例自适应。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size of the current line; surrounding lines scale proportionally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前行字号；前后行按比例自适应。"
          }
        }
      }
    },
    "每首歌单独记住的歌词提前 / 延后量。要改请用下面的校准。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lyric offset remembered for each song. Use Calibrate below to change it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每首歌单独记住的歌词提前 / 延后量。要改请用下面的校准。"
          }
        }
      }
    },
    "在完整播放器右侧的校准面板里用方向键微调，回车保存。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine-tune with the arrow keys in the calibration panel on the right of the full player, then press Return to save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在完整播放器右侧的校准面板里用方向键微调，回车保存。"
          }
        }
      }
    },
    "每次打开 App 时使用的音量；之后跟随你手动调整。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume used each time the app opens; afterwards it follows your adjustments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打开 App 时使用的音量；之后跟随你手动调整。"
          }
        }
      }
    },
    "只在打开 App 时使用一次。静音只在这次运行有效，下次打开按这里的音量出声。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied once when the app opens. Mute lasts only for this session; next time it starts at this volume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在打开 App 时使用一次。静音只在这次运行有效，下次打开按这里的音量出声。"
          }
        }
      }
    },
