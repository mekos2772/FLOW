          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和播放条上的播放模式按钮同步，切换后立即保存。"
          }
        }
      }
    },
    "从当前队列里随机取下一首，与循环模式互不影响。": {
      "extractionState": "manual",
