    "空间很宽裕才恢复，长期专注时更安静。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores only when there's plenty of space — quieter during long focus sessions."
