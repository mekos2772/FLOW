    "切歌时 0.12 秒淡入淡出，避免在线歌曲起播时的爆音。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 0.12-second fade when switching songs, avoiding pops when online songs start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切歌时 0.12 秒淡入淡出，避免在线歌曲起播时的爆音。"
          }
        }
      }
    },
    "一首放完自动接相关歌曲；全部播过就停下，不会随便重播。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a song ends, related songs play next. Stops once everything has played instead of repeating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一首放完自动接相关歌曲；全部播过就停下，不会随便重播。"
          }
        }
      }
    },
    "离线缓存": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline Cache"
          }
        },
